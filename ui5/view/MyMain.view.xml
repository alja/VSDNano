<mvc:View height="100%" class="sapUiSizeCompact"
          controllerName="custom.controller.MyNewMain"
          xmlns="sap.m"
          xmlns:mvc="sap.ui.core.mvc"
          xmlns:l="sap.ui.layout"
          xmlns:commons="sap.ui.commons">
   <!-- titleAlignment="Center" keeps Run/Lumi/Event (the header's contentMiddle) in the
        middle of the bar; with the theme default it sits right after the left buttons.
        It must be set here: the Page copies its value onto the header bar. -->
   <Page title="EVE-7" showNavButton="false" showFooter="false" enableScrolling="false" titleAlignment="Center"
         showHeader="true"
         showSubHeader="true" class="sapUiSizeCompact" id="CanvasMainPage">
     <dependents>
       <!-- Opened by the Settings button. Declared here, not loaded lazily, because
            the controller reads lineScaleInput and projections before the popover is shown. -->
       <Popover id="settingsPopover" title="Settings" placement="Bottom"
                class="sapUiResponsivePadding--header">
         <VBox class="sapUiSmallMargin">
           <HBox alignItems="Center">
             <Label text="Line width:" labelFor="lineScaleInput" width="13em"/>
             <Input id="lineScaleInput" width="5em" type="Number" textAlign="Center" value="2"
                    tooltip="RQ_LineScale" change="onLineScaleChange"/>
           </HBox>
           <HBox alignItems="Center" class="sapUiTinyMarginTop">
             <Label text="RhoZ projection plane angle:" labelFor="projections" width="13em"/>
             <Button icon="sap-icon://less" press="onProjectionStepDown" tooltip="Decrease by 1"/>
             <Input id="projections" value="0" type="Number" width="5em" textAlign="Center"
                    change="onProjectionSubmit"/>
             <Button icon="sap-icon://add" press="onProjectionStepUp" tooltip="Increase by 1"/>
           </HBox>
         </VBox>
       </Popover>
     </dependents>
     <customHeader>
       <Bar id="otb1" >
         <contentLeft>
            <!-- File menu hidden; set visible="true" to bring it back -->
            <MenuButton text="File"  enabled="false" visible="false">
               <menu>
                  <Menu itemSelected="onFileMenuAction">
                     <items>
                        <MenuItem text="Open" icon="sap-icon://open-folder" />
                        <MenuItem text="Close canvas" icon="sap-icon://decline" />
                        <MenuItem text="Save" startsSection="true"
                           icon="sap-icon://save">
                           <items>
                              <MenuItem text="Canvas.png" />
                              <MenuItem text="Canvas.svg" />
                              <MenuItem text="Canvas.jpeg" />
                           </items>
                        </MenuItem>
                        <MenuItem text="Save as ..." icon="sap-icon://save" />
                        <MenuItem text="Interrupt"
                           startsSection="true" icon="sap-icon://stop" />
                        <MenuItem text="Quit ROOT" icon="sap-icon://system-exit" />

                     </items>
                  </Menu>
               </menu>
            </MenuButton>
            <MenuButton text="View" type="Transparent"  enabled="true"
                        visible="true">
              <menu>
                <Menu itemSelected="onViewMenuActionxxx" id="menuViewId">
                  <items>
                    <MenuItem text="New Viewer" enabled="false" >
                      <items>
                        <MenuItem text="3D"  enabled="false"/>
                        <MenuItem text="RhoZ" enabled="false" />
                        <MenuItem text="RhoPhi" enabled="false"/>
                        <MenuItem text="Table" startsSection="true" enabled="false"/>
                      </items>
                    </MenuItem>
                  </items>
                </Menu>
              </menu>
            </MenuButton>
          <Button id="settingsBtn" text="Settings" icon="sap-icon://action-settings" type="Transparent"
               tooltip="Display settings" press="onPressSettings"/>
          <Button id="invMassBtn" text="InvMassDialog" type="Transparent"
               tooltip="Toggle GED editor" press="onPressInvMass"/>
         </contentLeft>

         
         <contentMiddle>

            <Label id="runLabel" text="Run "  class="sapUiTinyMargin"/>
            <Input id="runInput" width="7em" class="sapUiTinyMargin" enabled="false"/>
            <Label id="lumiLabel" text="Lumi " />
            <Input id="lumiInput" width="7em"  class="sapUiTinyMargin" enabled="false"/>
            <Label id="event" text="Event "/>
            <Input id="eventInput" width="7em" class="sapUiTinyMargin" enabled="false"/>
                <!-- title hidden so Run/Lumi/Event sit in the centre; set visible="true" to show it -->
                <FormattedText id="centerTitle" htmlText="Universal Format" visible="false"/>
         </contentMiddle>
         <contentRight>
          <Button id="logButton"
                  text="Log URL" press="showFWLog"/>
         </contentRight>
        </Bar>
     </customHeader>
     <subHeader>
        <!-- A Bar, like the header, so GoToEvent (contentMiddle) sits in the middle,
             under Run/Lumi/Event. The Page sets titleAlignment only on the header,
             so the subheader needs its own. -->
        <Bar id="otb2" titleAlignment="Center">
          <contentLeft>
            <Text text="Navigate events: " />
            <Button id="prevEvent" icon="sap-icon://media-reverse" press="prevEvent" />
            <Button id="nextEvent" icon="sap-icon://media-play" press="nextEvent" />

            <!-- AutoPlay controls hidden; set visible="true" on the three controls to bring them back -->
            <Label text="AutoPlay:" visible="false" />
            <CheckBox id="autoplayId" class="sapUiNoMarginRight" select="autoplay" visible="false" />
            <Slider id="playdelayId" visible="false" value="1" min="1" max="10" width="6em" change="playdelay" showAdvancedTooltip="true" class="sapUiNoMargin" />

            <Label id="dateLabel" />
          </contentLeft>
          <contentMiddle>
            <Label text="GoToEvent:" labelFor="gotoEventInput" />
            <Input id="gotoEventInput" width="5em" type="Number" textAlign="Center" value="0"
                   tooltip="Go to event by index" change="onGotoEventSubmit" />
          </contentMiddle>
          <contentRight>
            <Label id="fileName" text="__________________________________" textAlign="End" />
            <Label id="fileNav" text="[__/____]" />
          </contentRight>
        </Bar>
      </subHeader>
      <content>
        <l:Splitter orientation="Horizontal" id="MainAreaSplitter">
          <l:contentAreas>
             <mvc:XMLView id="Summary" viewName="custom.view.MySummary" height="100%">
                <mvc:layoutData><l:SplitterLayoutData size="15%"/></mvc:layoutData>
             </mvc:XMLView>
          </l:contentAreas>
        </l:Splitter>
      </content>
      <footer>
        <OverflowToolbar>
          <Label text="{/StatusLbl1}" id="FooterLbl1" />
          <Label text="{/StatusLbl2}" id="FooterLbl2" />
          <Label text="{/StatusLbl3}" id="FooterLbl3" />
          <Label text="{/StatusLbl4}" id="FooterLbl4" />
        </OverflowToolbar>
      </footer>
    </Page>
  </mvc:View>
